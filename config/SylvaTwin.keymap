#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        prtsc {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <10 11>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <30 44>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <29 43>;
        };

        RightClick2 {
            bindings = <&mkp RCLK>;
            key-positions = <31 45>;
        };

        MiddleClick2 {
            bindings = <&mkp MCLK>;
            key-positions = <32 46>;
        };

        zen-han {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 28>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 27>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <40 26>;
        };

        prev_click {
            bindings = <&mkp MB4>;
            key-positions = <29 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q         &kp W             &kp E  &kp R  &kp T                        &kp Y  &kp U  &kp I              &kp O              &kp P           &kp BSPC
&kp LCTRL   &kp A         &kp S             &kp D  &kp F  &kp G                        &kp H  &kp J  &kp K              &kp L              &kp SEMI        &kp SINGLE_QUOTE
&kp LSHIFT  &kp Z         &kp X             &kp C  &kp V  &kp B  &mkp LCLK  &mkp RCLK  &kp N  &kp M  &kp COMMA          &kp DOT            &kp SLASH       &mt RSHIFT MINUS
&mo 1       &kp LEFT_ALT  &kp LEFT_COMMAND  &none  &none  &mo 2  &kp SPACE  &kp ENTER  &mo 2  &mo 1  &kp RIGHT_COMMAND  &kp RIGHT_CONTROL  &kp LEFT_ARROW  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&kp ESCAPE      &kp EXCLAMATION  &kp AT_SIGN     &kp POUND        &kp DOLLAR    &kp PERCENT                       &kp CARET  &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&trans          &trans           &kp UP_ARROW    &trans           &trans        &trans                            &kp TILDE  &kp MINUS       &kp PLUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH
&studio_unlock  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans        &trans        &trans      &trans  &kp GRAVE  &kp UNDERSCORE  &kp EQUAL     &kp SEMICOLON         &kp SINGLE_QUOTE       &kp PIPE
&trans          &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &trans  &trans     &trans          &trans        &trans                &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                        &trans          &trans          &trans        &trans           &trans  &trans
&trans      &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans                        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans      &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &trans  &trans  &trans          &trans          &trans        &trans           &trans  &trans
&trans      &trans  &trans        &trans        &trans        &trans        &trans  &trans  &trans          &trans          &trans        &trans           &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
